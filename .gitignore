# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Node dependencies
node_modules/

# Scratch workspace (local comparison snapshots, throwaway tooling caches)
.tmp/

# UI build output (Vite writes it straight into public/, never commit it)
dist/
public/index.html
public/assets/scripts/*
public/assets/styles/index.css
public/assets/index-*.js
public/assets/index-*.css

# TypeScript cache
*.tsbuildinfo

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Python CLI build output
packages/cli/build/
packages/cli/dist/
